{
  "$defs": {
    "CropRect": {
      "description": "Even-aligned source crop stripping baked letterbox/pillarbox bars.",
      "properties": {
        "h": {
          "minimum": 2,
          "title": "H",
          "type": "integer"
        },
        "w": {
          "minimum": 2,
          "title": "W",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "CropRect",
      "type": "object"
    },
    "RationalFPS": {
      "description": "Exact rational frame rate (e.g., 30000/1001 for 29.97 fps).",
      "properties": {
        "den": {
          "description": "Frame rate denominator.",
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "description": "Frame rate numerator.",
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "RationalFPS",
      "type": "object"
    },
    "ShotMetadata": {
      "description": "Indexed visual shot with motion, sharpness, and framing metadata.",
      "properties": {
        "crop_x_norm": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Crop X Norm",
          "type": "number"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "face_ratio": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Face Ratio",
          "type": "number"
        },
        "is_dark_or_flat": {
          "default": false,
          "title": "Is Dark Or Flat",
          "type": "boolean"
        },
        "keyframe_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Keyframe Paths",
          "type": "array"
        },
        "motion_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Motion Score",
          "type": "number"
        },
        "sharpness_score": {
          "minimum": 0.0,
          "title": "Sharpness Score",
          "type": "number"
        },
        "shot_id": {
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "shot_tag": {
          "default": "action",
          "title": "Shot Tag",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text_clutter_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Text Clutter Score",
          "type": "number"
        }
      },
      "required": [
        "shot_id",
        "start_ms",
        "end_ms",
        "motion_score",
        "sharpness_score"
      ],
      "title": "ShotMetadata",
      "type": "object"
    }
  },
  "description": "Ordered catalog of visual shots indexed from a source/proxy video.",
  "properties": {
    "active_crop": {
      "anyOf": [
        {
          "$ref": "#/$defs/CropRect"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "has_audio": {
      "default": false,
      "title": "Has Audio",
      "type": "boolean"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotMetadata"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "source_path": {
      "minLength": 1,
      "title": "Source Path",
      "type": "string"
    },
    "video_fps": {
      "$ref": "#/$defs/RationalFPS"
    }
  },
  "required": [
    "source_path",
    "video_fps",
    "shots"
  ],
  "title": "ShotCatalog",
  "type": "object"
}
