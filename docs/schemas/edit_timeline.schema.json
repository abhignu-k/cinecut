{
  "$defs": {
    "EffectType": {
      "description": "Per-clip kinetic post-processing effects supported in v0.1.",
      "enum": [
        "none",
        "zoom_punch"
      ],
      "title": "EffectType",
      "type": "string"
    },
    "NarrativeRole": {
      "description": "Story arc role assigned to a timeline clip.",
      "enum": [
        "setup",
        "tension",
        "climax",
        "release"
      ],
      "title": "NarrativeRole",
      "type": "string"
    },
    "RationalFPS": {
      "description": "Exact rational frame rate (e.g., 30000/1001 for 29.97 fps).",
      "properties": {
        "den": {
          "description": "Frame rate denominator.",
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "description": "Frame rate numerator.",
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "RationalFPS",
      "type": "object"
    },
    "TimelineClip": {
      "description": "Single source-to-destination edit decision with strict sync check.",
      "properties": {
        "dst_end_ms": {
          "exclusiveMinimum": 0,
          "title": "Dst End Ms",
          "type": "integer"
        },
        "dst_start_ms": {
          "minimum": 0,
          "title": "Dst Start Ms",
          "type": "integer"
        },
        "effect": {
          "$ref": "#/$defs/EffectType",
          "default": "none"
        },
        "narrative_role": {
          "$ref": "#/$defs/NarrativeRole",
          "default": "setup"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "shot_id": {
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Speed",
          "type": "number"
        },
        "src_end_ms": {
          "exclusiveMinimum": 0,
          "title": "Src End Ms",
          "type": "integer"
        },
        "src_start_ms": {
          "minimum": 0,
          "title": "Src Start Ms",
          "type": "integer"
        },
        "transition": {
          "$ref": "#/$defs/TransitionType",
          "default": "cut"
        }
      },
      "required": [
        "shot_id",
        "src_start_ms",
        "src_end_ms",
        "dst_start_ms",
        "dst_end_ms",
        "rationale"
      ],
      "title": "TimelineClip",
      "type": "object"
    },
    "TransitionType": {
      "description": "Clip-to-clip transition styles supported in v0.1.",
      "enum": [
        "cut",
        "flash",
        "crossfade"
      ],
      "title": "TransitionType",
      "type": "string"
    }
  },
  "description": "Validated, contiguous edit timeline ready for FFmpeg and OTIO.",
  "properties": {
    "audio_duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Audio Duration Ms",
      "type": "integer"
    },
    "audio_start_ms": {
      "minimum": 0,
      "title": "Audio Start Ms",
      "type": "integer"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/TimelineClip"
      },
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    },
    "height": {
      "default": 1920,
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "target_fps": {
      "$ref": "#/$defs/RationalFPS"
    },
    "width": {
      "default": 1080,
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "target_fps",
    "audio_start_ms",
    "audio_duration_ms",
    "clips"
  ],
  "title": "EditTimeline",
  "type": "object"
}
