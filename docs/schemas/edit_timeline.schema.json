{
  "$defs": {
    "EffectType": {
      "description": "Per-clip kinetic post-processing effects supported in v0.1.",
      "enum": [
        "none",
        "zoom_punch"
      ],
      "title": "EffectType",
      "type": "string"
    },
    "FramingMode": {
      "description": "Target aspect framing strategy for source footage.",
      "enum": [
        "blur",
        "cinema",
        "crop"
      ],
      "title": "FramingMode",
      "type": "string"
    },
    "GradePreset": {
      "description": "Supported cinematic color-grading presets.",
      "enum": [
        "auto",
        "moody",
        "warm",
        "crisp",
        "none"
      ],
      "title": "GradePreset",
      "type": "string"
    },
    "NarrativeRole": {
      "description": "Story arc role assigned to a timeline clip.",
      "enum": [
        "setup",
        "tension",
        "climax",
        "release"
      ],
      "title": "NarrativeRole",
      "type": "string"
    },
    "RationalFPS": {
      "description": "Exact rational frame rate (e.g., 30000/1001 for 29.97 fps).",
      "properties": {
        "den": {
          "description": "Frame rate denominator.",
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "description": "Frame rate numerator.",
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "RationalFPS",
      "type": "object"
    },
    "TimelineClip": {
      "description": "Single source-to-destination edit decision with strict sync check.",
      "properties": {
        "crop_x_norm": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Crop X Norm",
          "type": "number"
        },
        "dst_end_ms": {
          "minimum": 1,
          "title": "Dst End Ms",
          "type": "integer"
        },
        "dst_start_ms": {
          "minimum": 0,
          "title": "Dst Start Ms",
          "type": "integer"
        },
        "effect": {
          "$ref": "#/$defs/EffectType",
          "default": "none"
        },
        "narrative_role": {
          "$ref": "#/$defs/NarrativeRole",
          "default": "setup"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "sfx_gain": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sfx Gain",
          "type": "number"
        },
        "shot_id": {
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Speed",
          "type": "number"
        },
        "src_end_ms": {
          "minimum": 1,
          "title": "Src End Ms",
          "type": "integer"
        },
        "src_start_ms": {
          "minimum": 0,
          "title": "Src Start Ms",
          "type": "integer"
        },
        "transition": {
          "$ref": "#/$defs/TransitionType",
          "default": "cut"
        }
      },
      "required": [
        "shot_id",
        "src_start_ms",
        "src_end_ms",
        "dst_start_ms",
        "dst_end_ms"
      ],
      "title": "TimelineClip",
      "type": "object"
    },
    "TransitionType": {
      "description": "Clip-to-clip transition styles preserving exact boundary timing.",
      "enum": [
        "cut",
        "flash"
      ],
      "title": "TransitionType",
      "type": "string"
    }
  },
  "description": "Validated, self-contained edit timeline ready for FFmpeg and OTIO.",
  "properties": {
    "audio_duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Audio Duration Ms",
      "type": "integer"
    },
    "audio_path": {
      "minLength": 1,
      "title": "Audio Path",
      "type": "string"
    },
    "audio_start_ms": {
      "minimum": 0,
      "title": "Audio Start Ms",
      "type": "integer"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/TimelineClip"
      },
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    },
    "framing": {
      "$ref": "#/$defs/FramingMode",
      "default": "blur"
    },
    "grade": {
      "$ref": "#/$defs/GradePreset",
      "default": "moody"
    },
    "height": {
      "default": 1920,
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "render_video_path": {
      "minLength": 1,
      "title": "Render Video Path",
      "type": "string"
    },
    "sfx_audio_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sfx Audio Path"
    },
    "sfx_mix": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Sfx Mix",
      "type": "number"
    },
    "source_video_path": {
      "minLength": 1,
      "title": "Source Video Path",
      "type": "string"
    },
    "target_fps": {
      "$ref": "#/$defs/RationalFPS"
    },
    "width": {
      "default": 1080,
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "source_video_path",
    "render_video_path",
    "audio_path",
    "target_fps",
    "audio_start_ms",
    "audio_duration_ms",
    "clips"
  ],
  "title": "EditTimeline",
  "type": "object"
}
