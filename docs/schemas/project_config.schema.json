{
  "$defs": {
    "EngineType": {
      "description": "Supported AI planning engine backends.",
      "enum": [
        "gemini",
        "gemma",
        "mock"
      ],
      "title": "EngineType",
      "type": "string"
    },
    "RationalFPS": {
      "description": "Exact rational frame rate (e.g., 30000/1001 for 29.97 fps).",
      "properties": {
        "den": {
          "description": "Frame rate denominator.",
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "description": "Frame rate numerator.",
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "RationalFPS",
      "type": "object"
    }
  },
  "description": "Domain configuration for a cinecut edit run.",
  "properties": {
    "audio_source": {
      "minLength": 1,
      "title": "Audio Source",
      "type": "string"
    },
    "audio_start_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Start Ms"
    },
    "duration_ms": {
      "default": 30000,
      "exclusiveMinimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "engine": {
      "$ref": "#/$defs/EngineType",
      "default": "gemini"
    },
    "full_audio": {
      "default": false,
      "title": "Full Audio",
      "type": "boolean"
    },
    "stems": {
      "default": false,
      "title": "Stems",
      "type": "boolean"
    },
    "target_fps": {
      "$ref": "#/$defs/RationalFPS"
    },
    "vibe": {
      "minLength": 1,
      "title": "Vibe",
      "type": "string"
    },
    "video_source": {
      "minLength": 1,
      "title": "Video Source",
      "type": "string"
    }
  },
  "required": [
    "video_source",
    "audio_source",
    "vibe"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
