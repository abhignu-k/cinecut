{
  "$defs": {
    "AspectPreset": {
      "description": "Supported target aspect ratio presets for final rendering.",
      "enum": [
        "auto",
        "native",
        "4:5",
        "4:3",
        "16:9",
        "9:16"
      ],
      "title": "AspectPreset",
      "type": "string"
    },
    "EditScript": {
      "description": "Narrative blueprint written prior to millisecond clip casting.",
      "properties": {
        "arc_summary": {
          "minLength": 1,
          "title": "Arc Summary",
          "type": "string"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/ScriptBeat"
          },
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "logline": {
          "minLength": 1,
          "title": "Logline",
          "type": "string"
        },
        "recommended_aspect": {
          "$ref": "#/$defs/AspectPreset",
          "default": "auto"
        },
        "recommended_grade": {
          "$ref": "#/$defs/GradePreset",
          "default": "moody"
        }
      },
      "required": [
        "logline",
        "arc_summary",
        "beats"
      ],
      "title": "EditScript",
      "type": "object"
    },
    "EffectType": {
      "description": "Per-clip kinetic post-processing effects supported in v0.1.",
      "enum": [
        "none",
        "zoom_punch"
      ],
      "title": "EffectType",
      "type": "string"
    },
    "GradePreset": {
      "description": "Supported cinematic color-grading presets.",
      "enum": [
        "auto",
        "moody",
        "warm",
        "crisp",
        "none"
      ],
      "title": "GradePreset",
      "type": "string"
    },
    "NarrativeRole": {
      "description": "Story arc role assigned to a timeline clip.",
      "enum": [
        "setup",
        "tension",
        "climax",
        "release"
      ],
      "title": "NarrativeRole",
      "type": "string"
    },
    "ScriptBeat": {
      "description": "Single narrative chapter mapping a song span to director intent.",
      "properties": {
        "beat_index": {
          "minimum": 1,
          "title": "Beat Index",
          "type": "integer"
        },
        "dst_end_ms": {
          "minimum": 1,
          "title": "Dst End Ms",
          "type": "integer"
        },
        "dst_start_ms": {
          "minimum": 0,
          "title": "Dst Start Ms",
          "type": "integer"
        },
        "pacing_style": {
          "default": "medium",
          "title": "Pacing Style",
          "type": "string"
        },
        "preferred_tags": {
          "items": {
            "type": "string"
          },
          "title": "Preferred Tags",
          "type": "array"
        },
        "section": {
          "$ref": "#/$defs/SectionLabel"
        },
        "story_goal": {
          "minLength": 1,
          "title": "Story Goal",
          "type": "string"
        },
        "use_sfx": {
          "default": false,
          "title": "Use Sfx",
          "type": "boolean"
        },
        "visual_direction": {
          "minLength": 1,
          "title": "Visual Direction",
          "type": "string"
        }
      },
      "required": [
        "beat_index",
        "section",
        "dst_start_ms",
        "dst_end_ms",
        "story_goal",
        "visual_direction"
      ],
      "title": "ScriptBeat",
      "type": "object"
    },
    "SectionLabel": {
      "description": "Semantic musical section classification.",
      "enum": [
        "intro",
        "buildup",
        "drop",
        "bridge",
        "outro"
      ],
      "title": "SectionLabel",
      "type": "string"
    },
    "TimelineClipDraft": {
      "description": "Relaxed clip proposal emitted by an AI backend prior to solver repair.",
      "properties": {
        "dst_end_ms": {
          "minimum": 1,
          "title": "Dst End Ms",
          "type": "integer"
        },
        "dst_start_ms": {
          "minimum": 0,
          "title": "Dst Start Ms",
          "type": "integer"
        },
        "effect": {
          "$ref": "#/$defs/EffectType",
          "default": "none"
        },
        "narrative_role": {
          "$ref": "#/$defs/NarrativeRole",
          "default": "setup"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "script_beat_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Beat Index"
        },
        "shot_id": {
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "title": "Speed",
          "type": "number"
        },
        "src_end_ms": {
          "minimum": 1,
          "title": "Src End Ms",
          "type": "integer"
        },
        "src_start_ms": {
          "minimum": 0,
          "title": "Src Start Ms",
          "type": "integer"
        },
        "transition": {
          "$ref": "#/$defs/TransitionType",
          "default": "cut"
        },
        "use_sfx": {
          "default": false,
          "title": "Use Sfx",
          "type": "boolean"
        }
      },
      "required": [
        "shot_id",
        "src_start_ms",
        "src_end_ms",
        "dst_start_ms",
        "dst_end_ms"
      ],
      "title": "TimelineClipDraft",
      "type": "object"
    },
    "TransitionType": {
      "description": "Clip-to-clip transition styles preserving exact boundary timing.",
      "enum": [
        "cut",
        "flash"
      ],
      "title": "TransitionType",
      "type": "string"
    }
  },
  "description": "Relaxed timeline proposal emitted by an AI backend.",
  "properties": {
    "clips": {
      "items": {
        "$ref": "#/$defs/TimelineClipDraft"
      },
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    },
    "recommended_grade": {
      "$ref": "#/$defs/GradePreset",
      "default": "moody"
    },
    "recommended_sfx_mix": {
      "default": 0.0,
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Recommended Sfx Mix",
      "type": "number"
    },
    "script": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditScript"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "clips"
  ],
  "title": "EditTimelineDraft",
  "type": "object"
}
